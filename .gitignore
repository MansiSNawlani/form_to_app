# dependencies
node_modules/

# frontend build output
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# python
# The root pyproject.toml is for the Vercel deployment; its lock is produced at
# build time. Not committed, because every other dependency list in this project
# is a range rather than a pin, and one locked corner would be the odd one out.
uv.lock

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# env files
.env
.env.*
!.env.example

# local database and uploads
deployment/data/
uploads/

# Real filled-in protocols, for testing the PDF import against files this
# project did not write. Never committed: a filed protocol carries the
# surveyor's name, postal address, telephone number and e-mail address, and
# there is no consent on record for putting any of that in a repository. The
# blank forms in Resources/Fiaka_Resources/ are committed and carry nobody's
# data; these do. Keep your own copies here and they stay out of every commit.
Resources/echte-protokolle/*
!Resources/echte-protokolle/README.md

# editors and OS
.DS_Store
Thumbs.db
*.swp

# logs
*.log
npm-debug.log*
