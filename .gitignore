# dependencies
node_modules/

# frontend build output
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# python
# The root pyproject.toml is for the Vercel deployment; its lock is produced at
# build time. Not committed, because every other dependency list in this project
# is a range rather than a pin, and one locked corner would be the odd one out.
uv.lock

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# env files
.env
.env.*
!.env.example

# local database and uploads
deployment/data/
uploads/

# The source material FFS supplies, and nothing of ours.
#
# Untracked entirely by decision on 2026-09-22. Two different reasons sit in
# this one directory and both point the same way. The filled-in protocols under
# echte-protokolle/ carry the surveyor's name, postal address, telephone number
# and e-mail address, and nobody consented to that being in a repository. The
# blank forms and their JavaScript under Fiaka_Resources/ are FFS's own
# documents rather than this project's work, and a repository is not where
# somebody else's distribution belongs.
#
# What this costs, and how it is handled: the field and option definition is
# generated from the blank form, and the generated files under database/seed/
# stay committed, so the application and the container need nothing from here.
# The tests that read a form skip with a message naming what to fetch, the same
# way the database tests skip when no database is running. AGENTS.md says where
# to put the files.
Resources/

# editors and OS
.DS_Store
Thumbs.db
*.swp

# logs
*.log
npm-debug.log*

# rendered diagrams. blueprint/history/flow_diagrams/ holds the PlantUML source;
# the pictures are regenerated from it on demand (VS Code's PlantUML extension,
# or `plantuml <file>.puml`). Committing them would mean a second copy that goes
# stale the moment a .puml changes, which is exactly what the diagrams already
# have to be guarded against.
blueprint/history/flow_diagrams/*.png
blueprint/history/flow_diagrams/*.svg
