# Copy to .env for local development. .env is git-ignored.
#
# These are local development values, not credentials. Real secrets come from
# the deployment environment, never from this repository or a container image.
#
# One file serves both ways of running the backend:
#   - docker compose reads POSTGRES_* below, and builds the container's own
#     DATABASE_URL from them pointing at the "db" service.
#   - running uvicorn directly on the host reads DATABASE_URL below, which
#     points at localhost instead.

POSTGRES_USER=befischung
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=befischung

# Host-side only. Compose overrides this for the container, where the database
# is reachable as "db" rather than "localhost".
DATABASE_URL=postgresql+asyncpg://befischung:local-dev-only@localhost:5432/befischung

# Signs the login sessions. Anybody holding this can mint a valid session for any
# account, so a real deployment supplies its own from the environment and never
# from a file in the repository. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everybody out, which is also the answer if it ever leaks.
JWT_SECRET=generate-your-own-see-the-command-above

# Optional. How long a session lasts, in hours. Defaults to 8.
# SITZUNGSDAUER_STUNDEN=8

# Optional. Whether the session cookie is marked Secure, so the browser only
# sends it over https. Defaults to true, which also works on http://localhost
# because browsers treat localhost as trustworthy. Set it to false only when
# serving the stack over plain http on some other host.
# COOKIE_SECURE=true
